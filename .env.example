# ==========================================================================
# Interview AI - Environment Configurations Example
# ==========================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Settings (PostgreSQL config)
# FALLBACK: SQLite database file is created automatically if PG credentials are empty.
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=interview_ai_db
PG_USER=postgres
PG_PASSWORD=postgres_password

# Authentication (JWT Secret Key)
JWT_SECRET=super_secret_interview_ai_signing_key_change_me_in_prod
JWT_EXPIRY=24h

# Generative AI API Keys (Optional - Unlocks LLM questioning and evaluations)
# FALLBACK: Built-in local rule-based Question & Evaluation engine is used if empty.
GEMINI_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# External Voice Synthesis (Optional)
# FALLBACK: Native web SpeechSynthesis API is used if empty.
GOOGLE_APPLICATION_CREDENTIALS=path_to_google_cloud_tts_credentials.json
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
